# Supabase project URL and publishable (anon) key.
# The publishable key is safe to expose in the browser; never use a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional legacy name for the same key.
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional AI keys if used by your deployment.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
